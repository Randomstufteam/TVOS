<?xml version="1.0" encoding="utf-8"?>
<!-- A button standing on its own (the card prompt, the App library pill): glass at rest, white when focused. The top
     bar's buttons use pill_bg, which leaves the glass to the bar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#47FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
